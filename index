<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>For My Love</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&family=Pacifico&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Nunito', sans-serif;
            background: linear-gradient(180deg, #ffe4e6 0%, #fff1f2 100%);
            overflow-x: hidden;
            -webkit-tap-highlight-color: transparent;
        }

        .font-hand {
            font-family: 'Pacifico', cursive;
        }

        /* Smooth Scrolling */
        html {
            scroll-behavior: smooth;
        }

        /* Floating Hearts Animation */
        .heart-bg {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 0;
            overflow: hidden;
        }
        
        .heart {
            position: absolute;
            bottom: -20px;
            color: rgba(255, 99, 132, 0.4);
            animation: floatUp 15s linear infinite;
        }

        @keyframes floatUp {
            0% { transform: translateY(0) rotate(0deg) scale(0.8); opacity: 0; }
            10% { opacity: 0.6; }
            90% { opacity: 0.6; }
            100% { transform: translateY(-110vh) rotate(360deg) scale(1.2); opacity: 0; }
        }

        /* Glassmorphism Cards */
        .glass-card {
            background: rgba(255, 255, 255, 0.7);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 2px solid rgba(255, 255, 255, 0.9);
            box-shadow: 0 8px 32px 0 rgba(255, 154, 162, 0.2);
        }

        /* Animations */
        .fade-in-up {
            animation: fadeInUp 0.8s ease-out forwards;
            opacity: 0;
            transform: translateY(20px);
        }

        @keyframes fadeInUp {
            to { opacity: 1; transform: translateY(0); }
        }

        .delay-100 { animation-delay: 0.1s; }
        .delay-200 { animation-delay: 0.2s; }
        .delay-300 { animation-delay: 0.3s; }
        .delay-400 { animation-delay: 0.4s; }

        /* Smack Animation */
        .shake {
            animation: shake 0.5s cubic-bezier(.36,.07,.19,.97) both;
        }

        @keyframes shake {
            10%, 90% { transform: translate3d(-2px, 0, 0) rotate(-5deg); }
            20%, 80% { transform: translate3d(4px, 0, 0) rotate(5deg); }
            30%, 50%, 70% { transform: translate3d(-6px, 0, 0) rotate(-5deg); }
            40%, 60% { transform: translate3d(6px, 0, 0) rotate(5deg); }
        }

        .pow-effect {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%) scale(0);
            transition: transform 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            pointer-events: none;
            z-index: 20;
        }

        .pow-effect.active {
            transform: translate(-50%, -50%) scale(1.5);
            animation: fadeOutPow 0.5s ease-out 0.5s forwards;
        }

        @keyframes fadeOutPow {
            to { opacity: 0; transform: translate(-50%, -60%) scale(1.8); }
        }

        /* Hug Modal */
        .hug-overlay {
            background: rgba(255, 255, 255, 0.95);
            transform: translateY(100%);
            transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .hug-overlay.open {
            transform: translateY(0);
        }

        /* Custom Scrollbar hide */
        ::-webkit-scrollbar {
            width: 0px;
            background: transparent;
        }
    </style>
</head>
<body class="text-gray-700 antialiased pb-20 select-none">

    <!-- Floating Hearts Background -->
    <div id="heart-bg" class="heart-bg"></div>

    <!-- Main Container (Mobile Width Constrained) -->
    <main class="relative z-10 max-w-md mx-auto min-h-screen px-6 py-8 flex flex-col gap-8">
        
        <!-- Header / Intro -->
        <header class="text-center fade-in-up">
            <div class="inline-block p-2 rounded-full bg-white shadow-sm mb-4">
                <span class="text-3xl">💌</span>
            </div>
            <h1 class="font-hand text-4xl text-rose-500 mb-2">Hey Beautiful</h1>
            <p class="text-rose-400 font-semibold text-sm tracking-widest uppercase">Just a little reminder</p>
        </header>

        <!-- The PI Quote -->
        <section class="glass-card rounded-3xl p-6 text-center transform rotate-1 hover:rotate-0 transition-transform duration-300 fade-in-up delay-100">
            <div class="text-5xl mb-4">🥧 + ∞</div>
            <p class="text-lg font-bold text-gray-800 leading-relaxed">
                "My love for you is like the value of <span class="text-rose-500">π</span>..."
            </p>
            <p class="mt-2 text-rose-600 font-hand text-2xl">
                ...it's irrational and never-ending.
            </p>
        </section>

        <!-- Sad Section -->
        <section class="fade-in-up delay-200">
            <div class="bg-blue-50 border-2 border-blue-100 rounded-3xl p-6 shadow-sm relative overflow-hidden group">
                <div class="absolute -right-4 -top-4 text-blue-100 text-8xl opacity-50 group-hover:scale-110 transition-transform">🌧️</div>
                <h2 class="text-xl font-bold text-blue-800 mb-2 relative z-10">Feeling a bit sad?</h2>
                <p class="text-blue-600 text-sm mb-4 relative z-10">Don't carry it alone. Let me hold you.</p>
                <button onclick="openHug()" class="relative z-10 w-full bg-white text-blue-500 font-bold py-3 px-6 rounded-xl shadow-sm hover:shadow-md transition-all active:scale-95 flex items-center justify-center gap-2">
                    <i class="fas fa-cloud-sun"></i> Read This
                </button>
            </div>
        </section>

        <!-- Angry Section -->
        <section class="fade-in-up delay-300">
            <div class="glass-card rounded-3xl p-6 text-center relative">
                <h2 class="text-xl font-bold text-gray-800 mb-4">Did I do something dumb? 😅</h2>
                
                <div class="relative w-48 h-48 mx-auto mb-6 cursor-pointer" onclick="smackFace()">
                    <!-- "POW" Effect -->
                    <div id="pow-effect" class="pow-effect font-hand text-5xl text-red-600 drop-shadow-lg font-bold" style="text-shadow: 2px 2px 0px #fff;">
                        POW!💥
                    </div>
                    
                    <!-- Avatar Image (Generic cute boy avatar - can be replaced) -->
                    <div id="avatar-container" class="w-full h-full rounded-full overflow-hidden border-4 border-white shadow-lg bg-rose-100 relative">
                        <!-- Using a cute SVG placeholder or Memoji style image -->
                        <img id="avatar-face" src="https://api.dicebear.com/7.x/avataaars/svg?seed=Felix&backgroundColor=ffdfbf" alt="My Face" class="w-full h-full object-cover transition-transform duration-200">
                        
                        <!-- Bandage (Hidden by default) -->
                        <div id="bandage" class="absolute top-10 left-12 text-4xl opacity-0 transition-opacity duration-300 transform -rotate-12">🤕</div>
                    </div>
                </div>

                <p class="text-sm text-gray-500 mb-4">Go ahead, let it out...</p>
                
                <button onclick="smackFace()" class="w-full bg-rose-500 text-white font-bold py-3 px-6 rounded-xl shadow-lg shadow-rose-200 active:bg-rose-600 active:scale-95 transition-all">
                    👊 Smack my face!
                </button>
            </div>
        </section>

        <!-- Reasons I Love You -->
        <section class="fade-in-up delay-400">
            <h2 class="text-center font-hand text-2xl text-rose-500 mb-6">Why You're My Favorite</h2>
            <div class="space-y-4">
                <!-- Reason 1 -->
                <div class="bg-white p-4 rounded-2xl shadow-sm flex items-center gap-4 transform transition-transform hover:scale-102">
                    <div class="bg-yellow-100 p-3 rounded-full text-yellow-600">
                        <i class="fas fa-laugh-beam"></i>
                    </div>
                    <div>
                        <h3 class="font-bold text-gray-800">Your Laugh</h3>
                        <p class="text-xs text-gray-500">It's literally my favorite sound.</p>
                    </div>
                </div>

                <!-- Reason 2 -->
                <div class="bg-white p-4 rounded-2xl shadow-sm flex items-center gap-4 transform transition-transform hover:scale-102">
                    <div class="bg-purple-100 p-3 rounded-full text-purple-600">
                        <i class="fas fa-magic"></i>
                    </div>
                    <div>
                        <h3 class="font-bold text-gray-800">Your Magic</h3>
                        <p class="text-xs text-gray-500">You make boring days feel like adventures.</p>
                    </div>
                </div>

                <!-- Reason 3 -->
                <div class="bg-white p-4 rounded-2xl shadow-sm flex items-center gap-4 transform transition-transform hover:scale-102">
                    <div class="bg-green-100 p-3 rounded-full text-green-600">
                        <i class="fas fa-home"></i>
                    </div>
                    <div>
                        <h3 class="font-bold text-gray-800">You Feel Like Home</h3>
                        <p class="text-xs text-gray-500">No matter where we are, I'm safe with you.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- Forever Section -->
        <footer class="text-center mt-8 mb-4 fade-in-up delay-400">
            <div class="text-rose-500 text-4xl mb-4 animate-bounce">💖</div>
            <p class="font-hand text-2xl text-gray-800">Forever & Always</p>
            <p class="text-xs text-gray-400 mt-2">Made with 100% Love by Me</p>
        </footer>

    </main>

    <!-- Full Screen Hug Modal -->
    <div id="hug-modal" class="hug-overlay fixed inset-0 z-50 flex flex-col items-center justify-center p-8 text-center">
        <button onclick="closeHug()" class="absolute top-6 right-6 text-gray-400 hover:text-gray-600 p-2">
            <i class="fas fa-times text-2xl"></i>
        </button>
        
        <div class="w-24 h-24 bg-blue-100 rounded-full flex items-center justify-center text-4xl mb-6 text-blue-500 animate-pulse">
            🫂
        </div>
        
        <h2 class="text-2xl font-bold text-gray-800 mb-4">Take a deep breath...</h2>
        <p class="text-gray-600 leading-relaxed mb-8">
            I know things feel heavy right now, but you are stronger than you think. <br><br>
            I am here. I am not going anywhere. <br>
            And I love you more than any bad day.
        </p>
        
        <p class="font-hand text-xl text-blue-500">Everything will be okay. ❤️</p>
        
        <button onclick="closeHug()" class="mt-12 bg-gray-100 text-gray-600 font-semibold py-3 px-8 rounded-full text-sm hover:bg-gray-200 transition-colors">
            I feel a little better
        </button>
    </div>

    <script>
        // 1. Floating Hearts Logic
        function createHearts() {
            const container = document.getElementById('heart-bg');
            const heartCount = 15; // Number of hearts on screen
            
            for(let i = 0; i < heartCount; i++) {
                const heart = document.createElement('div');
                heart.classList.add('heart');
                heart.innerHTML = '<i class="fas fa-heart"></i>';
                
                // Random positioning and timing
                heart.style.left = Math.random() * 100 + 'vw';
                heart.style.animationDuration = (Math.random() * 5 + 10) + 's'; // 10-15s
                heart.style.animationDelay = (Math.random() * 5) + 's';
                heart.style.fontSize = (Math.random() * 20 + 10) + 'px';
                
                container.appendChild(heart);
            }
        }

        // 2. Smack Face Logic
        let smackCount = 0;
        function smackFace() {
            const avatarContainer = document.getElementById('avatar-container');
            const powEffect = document.getElementById('pow-effect');
            const bandage = document.getElementById('bandage');
            const face = document.getElementById('avatar-face');

            // Reset animation to allow re-triggering
            avatarContainer.classList.remove('shake');
            powEffect.classList.remove('active');
            void avatarContainer.offsetWidth; // Trigger reflow

            // Add animation classes
            avatarContainer.classList.add('shake');
            powEffect.classList.add('active');

            // Change face expression (visual trick using scale/position)
            face.style.transform = 'scale(0.9) rotate(5deg)';
            setTimeout(() => {
                face.style.transform = 'scale(1) rotate(0deg)';
            }, 300);

            // Show bandage after 3 smacks
            smackCount++;
            if(smackCount >= 3) {
                bandage.style.opacity = '1';
            }

            // Optional: Vibrate device if supported (mobile feel)
            if (navigator.vibrate) {
                navigator.vibrate(50);
            }
        }

        // 3. Hug Modal Logic
        function openHug() {
            document.getElementById('hug-modal').classList.add('open');
            document.body.style.overflow = 'hidden'; // Prevent background scrolling
        }

        function closeHug() {
            document.getElementById('hug-modal').classList.remove('open');
            document.body.style.overflow = '';
        }

        // Initialize
        document.addEventListener('DOMContentLoaded', () => {
            createHearts();
        });
    </script>
</body>
</html>
